<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Pasek górny -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_back"
                app:tint="#00695C" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/title_lighting"
                android:textColor="#00695C"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- KARTA CZUJNIKA ŚWIATŁA: Rozpoznany tryb DAY / NIGHT oraz luksy -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#1A00695C"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Czujnik oświetlenia (BH1750)"
                        android:textColor="#8000695C"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLightSensorLux"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="--.-- lx"
                        android:textColor="#00695C"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDayNightBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_heating_button"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="☀️ DAY"
                    android:textColor="#00695C"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Zakładki wyboru strefy: INDOOR / OUTDOOR -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLightTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@android:color/transparent"
            app:tabIndicatorColor="#00695C"
            app:tabSelectedTextColor="#00695C"
            app:tabTextColor="#8000695C">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wewnętrzne (Indoor)" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zewnętrzne (Outdoor)" />
        </com.google.android.material.tabs.TabLayout>

        <TextView
            android:id="@+id/tvZoneSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Strefa: Oświetlenie salonu (LED Wew)"
            android:textColor="#8000695C"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivLightButton"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/ic_light_bulb"
            android:padding="24dp"
            android:background="@drawable/color_circle"
            android:backgroundTint="#2600695C"
            android:layout_marginTop="20dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvLightStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:text="OFF"
            android:textColor="#00695C"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Paleta kolorów -->
        <GridLayout
            android:id="@+id/colorGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="6"
            android:alignmentMode="alignMargins"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="35dp" />

        <!-- Suwak jasności -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_brightness"
                android:textColor="#00695C"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBrightnessPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textColor="#00695C"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/brightnessSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:max="100"
            android:progress="100"
            android:progressTint="#00695C"
            android:thumbTint="#00695C" />

        <!-- SEKCJA TYLKO DLA INDOOR: Efekty specjalne -->
        <LinearLayout
            android:id="@+id/layoutIndoorEffects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/label_special_effects"
                android:textColor="#00695C"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDisco"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_heating_button"
                    android:text="@string/btn_disco"
                    android:textColor="#00695C"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnRelax"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_heating_button"
                    android:text="@string/btn_relax"
                    android:textColor="#00695C"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnStrobe"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_heating_button"
                    android:text="@string/btn_strobe"
                    android:textColor="#00695C"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- SEKCJA TYLKO DLA OUTDOOR: Automatyka Dzień/Noc -->
        <androidx.cardview.widget.CardView
            android:id="@+id/layoutAutoMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="#1A00695C"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tryb automatyczny (Czujnik zmierzchu)"
                        android:textColor="#00695C"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Włącza oświetlenie elewacji w nocy (&lt; 100 lx)"
                        android:textColor="#8000695C"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAutoMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="#00695C"
                    app:trackTint="#4D00695C" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>