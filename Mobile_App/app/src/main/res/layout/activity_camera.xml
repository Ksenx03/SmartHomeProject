<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="?android:attr/windowBackground">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_back"
        app:tint="#00695C"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvCameraTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Live Camera"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#00695C"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toEndOf="@id/btnBack" />

    <!-- Поле для IP-адреса Raspberry Pi -->
    <LinearLayout
        android:id="@+id/rowStreamUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etStreamUrl"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="http://172.20.10.4:5000/video_feed"
            android:inputType="textUri"
            android:singleLine="true"
            android:textSize="13sp"
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="8dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConnectStream"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:paddingHorizontal="16dp"
            android:text="Connect"
            android:textStyle="bold"
            android:textColor="#00695C"
            android:background="@drawable/bg_heating_button" />
    </LinearLayout>

    <!-- Окно видеопотока -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardVideo"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="#101820"
        app:layout_constraintTop_toBottomOf="@id/rowStreamUrl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <WebView
            android:id="@+id/webViewCamera"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvCameraStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Raspberry Pi Camera Module 3 Wide (MJPEG Stream)"
        android:textSize="13sp"
        android:textColor="#8000695C"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/cardVideo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>